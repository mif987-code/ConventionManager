# PostgreSQL Connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=convention_manager
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_PORT=5432
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Server
PORT=3000
REGISTRATION_RATE_MAX=30
REGISTRATION_RATE_WINDOW_MS=900000
RECAPTCHA_TIMEOUT_MS=8000
GOOGLE_SHEETS_TIMEOUT_MS=10000
EMAIL_TIMEOUT_MS=10000
PAYMENT_API_TIMEOUT_MS=20000
PAYMENT_RESERVATION_MINUTES=30

# Auth
API_KEY=your_secret_api_key_here
JWT_SECRET=your_jwt_secret_here

# QR Code Security
QR_SECRET_KEY=your_qr_secret_key_here_change_in_production

# ── Payment Processing ────────────────────────────────────────────────────────
# Set PAYMENT_PROVIDER to one of: tilopay | onvopay | mock
# Leave as "mock" during development (no real charges).
PAYMENT_PROVIDER=mock

# Public URL of this backend (used to auto-build webhook return URLs)
APP_URL=https://your-domain.com

# ── TiloPay (Costa Rica / Central America) ───────────────────────────────────
# Get credentials from: https://admin.tilopay.com → API Settings
# Webhook (IPN) URL to register in Tilopay dashboard:
#   POST https://your-domain.com/api/payments/tilopay-return
TILOPAY_API_KEY=your_tilopay_api_key
TILOPAY_API_USER=your_tilopay_email@example.com
TILOPAY_CURRENCY=USD
# Optional — overrides auto-built return URL:
# TILOPAY_REDIRECT_URL=https://your-domain.com/api/payments/tilopay-return

# ── OnvoPay (Costa Rica — SINPE Móvil + cards) ───────────────────────────────
# Get credentials from: https://dashboard.onvopay.com → Developers → API Keys
# Webhook URL to register in OnvoPay dashboard → Developers → Webhooks:
#   POST https://your-domain.com/api/payments/onvo-webhook
ONVO_SECRET_KEY=onvo_live_sk_...
ONVO_CURRENCY=CRC
# Optional — overrides auto-built redirect URLs:
# ONVO_REDIRECT_URL=https://your-domain.com/api/payments/onvo-return
# ONVO_CANCEL_URL=https://your-domain.com/register

RESEND_API_KEY=re_...
EMAIL_FROM=SparkFest <noreply@sparkfestcr.com>
PLAYER_APP_URL=https://register.sparkfestcr.com/app/
