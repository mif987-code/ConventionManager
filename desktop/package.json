{
  "name": "convention-manager",
  "version": "1.0.0",
  "description": "Convention Manager Desktop Application",
  "main": "dist/server-desktop.js",
  "bin": "dist/server-desktop.js",
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "../admin-panel/dist/**/*",
      "../registration-site/**/*",
      "../nfc-app/**/*",
      "../store-app/**/*",
      "../player-app/**/*",
      "../backend/data/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist-exe"
  },
  "scripts": {
    "build:backend": "cd ../backend && npm run build",
    "build:frontend": "cd ../admin-panel && npm run build",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:desktop",
    "build:desktop": "tsc",
    "package": "npm run build:all && pkg . --compress GZip",
    "start": "node dist/server-desktop.js"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "pkg": "^5.8.1",
    "typescript": "^5.6.0"
  }
}
