{
  "name": "convention-manager",
  "version": "1.0.0",
  "description": "Convention Manager Desktop",
  "author": "Convention Manager Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --publish=never",
    "setup": "node setup.js"
  },
  "build": {
    "appId": "com.convention.manager",
    "productName": "Convention Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../backend/dist/**/*",
      "../admin-panel/dist/**/*",
      "../registration-site/**/*",
      "../nfc-app/**/*",
      "../store-app/**/*",
      "../player-app/**/*",
      "!../**/node_modules",
      "!../**/src"
    ],
    "extraResources": [
      {
        "from": "../backend/data",
        "to": "data"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "42.3.2",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  }
}
